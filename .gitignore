# 凭据与本地配置
.env
.env.*
!.env.example
*.local

# IDE 配置（含本地绝对路径，不入库）
.idea/
*.iml

# 运行产物
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.next/
dist/
build/

# 证据与数据（体积大）
_evidence/**/raw/
*.db
*.db-shm
*.db-wal
*.sqlite
*.log
# 例外：_evidence/ 下的 *.log 是验收证据本体（pytest 输出、启动日志、跨模块调用日志），
# 规则 04 要求「真实执行的证据落到 _evidence/」。上面那条全局 *.log 把它们全部忽略了 ——
# 结果是仓库里只有 INDEX.md 的结论数字、没有任何一份日志可复核（2026-10-14 收尾复核发现）。
!_evidence/**/*.log
!_evidence/*.log

# 运行时数据库与上传产物（含真实合同内容，不入库）
projects/*/data/
!projects/*/data/.gitkeep
# 例外：P09 的真人质检评分标注（只有分数/评语/署名，不含客户对话内容）。
# 它是「人机一致性 Kappa」的唯一数据来源，必须能进仓库被复核。
!projects/p09-ai-sales-assessment/data/human_labels.json

# 服务托管运行时产物（日志/PID）与临时排查目录，不入库
_runtime/
_tmp_issue/

# 个人档案与含个人信息的文件：远端是公开仓库，一律不入库
# （.workbuddy/ 是各项目的会话记忆与交接档案，03-resume/ 是简历，_resume_dump.txt 是简历文本转储）
.workbuddy/
03-resume/
_tools/_resume_dump.txt
# 品牌位真源里存着用户上传的 logo dataURL，属本机数据；仓库靠各模块默认值兜底
shared/config/brand.json
