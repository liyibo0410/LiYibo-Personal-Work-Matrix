# ================= 凭据与运行配置模板（复制为 .env 后填入真实值）=================
#
# ⚠️ 阿里云百炼有【三套互相隔离】的凭证体系，Key 前缀必须与 Base URL 严格匹配，混用直接 401
#    sk-     按量付费      https://dashscope.aliyuncs.com/compatible-mode/v1         无期限
#    sk-sp-  Token Plan    https://token-plan.cn-beijing.maas.aliyuncs.com/...       按月清零不结转
#    sk-ws-  Coding Plan   https://coding.dashscope.aliyuncs.com/v1                  官方限定仅编程工具用

# ---- 【应用主力】按量付费：唯一提供全模型（含 Embedding / Rerank）且无有效期的通道 ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<YOUR_PAY_AS_YOU_GO_KEY_SK_XXXX>

# ---- 【备用】Token Plan（无 Embedding / Rerank）----
LLM_BASE_URL_FALLBACK=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY_FALLBACK=<YOUR_TOKEN_PLAN_KEY_SK_SP_XXXX>

# ---- 【编程工具】Coding Plan：配给 Qoder 使用，不要用于业务应用调用 ----
CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
CODING_API_KEY=<YOUR_CODING_PLAN_KEY_SK_WS_XXXX>

# ---- 模型分配 ----
LLM_MODEL=qwen3.8-max
LLM_MODEL_FAST=qwen3.8-flash
LLM_MODEL_REASONING=deepseek-v4.1-flash
LLM_MODEL_ALT=glm-5.3
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RERANK_MODEL=qwen3.7-text-rerank
IMAGE_MODEL=wan2.7-image-pro
TTS_MODEL=qwen-audio-3.0-realtime-plus
ASR_MODEL=qwen3.8-omni-flash
VLM_MODEL=qwen3.8-omni-flash
TRANSLATE_MODEL=qwen-mt-uni

# ---- 服务器（暂不部署，仅登记）----
SERVER_IP=39.96.200.45
PORTAL_PORT=8160
