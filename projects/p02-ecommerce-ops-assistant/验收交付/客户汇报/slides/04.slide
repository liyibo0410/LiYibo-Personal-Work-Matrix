        </Box>
        <Box style={{ height: 82, background: 'rgba(255,255,255,0.04)', border: '1px solid rgba(123,138,163,0.24)', borderRadius: 10, padding: '0 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#EAF0F8' }}>异步与编排</Text>
            <Text style={{ fontSize: 16, color: '#7B8AA3', fontFamily: "'JetBrains Mono',Consolas,monospace" }}>Celery + Redis · LangGraph 多 Agent 图 · inline 模式免依赖跑通</Text>
