        </Box>
        <Box style={{ height: 82, background: 'rgba(255,255,255,0.04)', border: '1px solid rgba(123,138,163,0.24)', borderRadius: 10, padding: '0 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#EAF0F8' }}>领域服务层</Text>
            <Text style={{ fontSize: 16, color: '#7B8AA3', fontFamily: "'JetBrains Mono',Consolas,monospace" }}>34 个服务 · 业务规则与事务边界 · 供应商适配</Text>
        </Box>
        <Box style={{ height: 82, background: 'rgba(255,255,255,0.04)', border: '1px solid rgba(123,138,163,0.24)', borderRadius: 10, padding: '0 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#EAF0F8' }}>数据与持久化</Text>
