        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#EAF0F8' }}>汇报要点</Text>
        <Text style={{ fontSize: 16, color: '#7B8AA3' }}>AGENDA</Text>
    </Box>
    <Box style={{ height: 520, flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
            <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#3370FF', fontFamily: "'JetBrains Mono',Consolas,monospace", width: 64 }}>01</Text>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 24, fontWeight: '600', color: '#EAF0F8' }}>痛点与目标</Text>
                <Text style={{ fontSize: 16, color: '#7B8AA3' }}>六类高频运营动作，为什么需要一条可验收的链路而不是又一个工具</Text>
            </Box>
        </Box>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
            <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#3370FF', fontFamily: "'JetBrains Mono',Consolas,monospace", width: 64 }}>02</Text>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
