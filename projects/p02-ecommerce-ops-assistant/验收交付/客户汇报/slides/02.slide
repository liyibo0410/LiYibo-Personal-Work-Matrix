            <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 24, fontWeight: '600', color: '#EAF0F8' }}>边界与下一步</Text>
                <Text style={{ fontSize: 16, color: '#7B8AA3' }}>安全合规约束、已知限制、以及后续改进优先级</Text>
            </Box>
        </Box>
    </Box>
